{
  "name": "@iflow-mcp/selenium-webdriver-mcp",
  "version": "0.4.1",
  "description": "A Model Context Protocol (MCP) server for Selenium WebDriver automation",
  "main": "dist/index.js",
  "bin": {
    "selenium-webdriver-mcp": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && npm run copy:config",
    "copy:config": "node -e \"const fs=require('fs'); fs.copyFileSync('version.config.json', 'dist/version.config.json');\"",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "prepare": "husky install"
  },
  "keywords": [
    "mcp",
    "selenium",
    "webdriver",
    "automation",
    "browser",
    "testing",
    "model-context-protocol"
  ],
  "author": "Prashant Shivaprasad",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "selenium-webdriver": "^4.27.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/selenium-webdriver": "^4.1.27",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pshivapr/selenium-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/pshivapr/selenium-mcp/issues"
  },
  "homepage": "https://github.com/pshivapr/selenium-mcp#readme"
}